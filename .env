# VITE_API_URL — URL backend API
# --------------------------------------------------
# Untuk testing di laptop (Development):
VITE_API_URL=http://localhost:8000

# --------------------------------------------------
# Untuk di Cloud / Production (Vercel):
# Jangan ubah file ini untuk production, 
# tapi masukkan variabel di bawah ini ke menu "Environment Variables" di dashboard Vercel kamu:
# VITE_API_URL = https://mindsense-backend-production.up.railway.app (Ganti dengan link Railway aslimu)
